# Copy to .env.local and fill in with values from the Supabase DEVELOPMENT project.
# Never commit real values. Never use production keys during development.

# Public (exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only (bypasses RLS). Only read from lib/supabase/admin.ts.
SUPABASE_SECRET_KEY=

# Test accounts for the e2e specs (npm run test:e2e), created by hand in the
# TESTING project (docs/como_probar.md). Fake emails are fine.
E2E_POSTULANTE_EMAIL=
E2E_POSTULANTE_PASSWORD=
E2E_EMPRESA_EMAIL=
E2E_EMPRESA_PASSWORD=
E2E_OFICINA_EMAIL=
E2E_OFICINA_PASSWORD=
