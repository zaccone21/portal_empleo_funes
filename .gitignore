# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local-only documents: they stay on this machine and never go to the repo
# (anything inside docs/local/, plus files with credentials)
/docs/local/
/docs/gmail_sender.txt
# raw interview transcript and old process drafts (DT-012)
/docs/Transcript.md
/docs/proceso_*.md
# the user's personal notes for the AI agent (DT-012, D-036)
/.agents/rules/preferencias-del-usuario.md
/.agents/rules/traspaso-desde-claude.md
